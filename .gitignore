# ==========================================
# Comprehensive Sample .gitignore File
# ==========================================

# --- System & OS Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Environment & Sensitive Data ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# --- Node.js / JavaScript Packages ---
node_modules/
jspm_packages/
bower_components/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/

# --- Java & Build Tools ---
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# --- Logs and Databases ---
*.log
*.sqlite
*.db

# --- IDEs and Text Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
